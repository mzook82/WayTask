# CLI-only local template. Do not add remote project credentials here.
WAYTASK_SUPABASE_ENVIRONMENT=local
WAYTASK_SUPABASE_URL=http://127.0.0.1:54321
WAYTASK_SUPABASE_PUBLISHABLE_KEY=

# Edge Function server environment. The kill switch is false by default.
# A real Gemini credential and random rate-limit salt belong only in Supabase
# staging secrets, never in this file, Xcode, the iOS bundle, or client storage.
WAYTASK_ENVIRONMENT=local
AI_RECOGNITION_ENABLED=false
GEMINI_API_KEY=
AI_RATE_LIMIT_HASH_SALT=
# Set only after proving the local/staging ingress overwrites this header and
# does not accept a client-spoofed value.
AI_TRUSTED_IP_HEADER=x-forwarded-for
