<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GEMINI_API_KEY</key>
	<string>$(GEMINI_API_KEY)</string>
	<key>WAYTASK_CLOUD_ACCOUNTS_ENABLED</key>
	<string>$(WAYTASK_CLOUD_ACCOUNTS_ENABLED)</string>
	<key>WAYTASK_CLOUD_MIGRATION_ENABLED</key>
	<string>$(WAYTASK_CLOUD_MIGRATION_ENABLED)</string>
	<key>WAYTASK_CLOUD_SYNC_ENABLED</key>
	<string>$(WAYTASK_CLOUD_SYNC_ENABLED)</string>
	<key>WAYTASK_SUPABASE_ENVIRONMENT</key>
	<string>$(WAYTASK_SUPABASE_ENVIRONMENT)</string>
	<key>WAYTASK_SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(WAYTASK_SUPABASE_PUBLISHABLE_KEY)</string>
	<key>WAYTASK_SUPABASE_URL</key>
	<string>$(WAYTASK_SUPABASE_URL)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>NSCameraUsageDescription</key>
	<string>WayTask uses the camera to scan barcodes and capture product photos.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>WayTask uses your location to remind you about shopping items near saved places.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WayTask uses your location to show nearby stores and shopping suggestions.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>WayTask can save captured product photos to your Photos library when you choose to save them.</string>
	<key>NSUserNotificationUsageDescription</key>
	<string>WayTask sends reminders when you are near saved shopping locations.</string>
</dict>
</plist>
