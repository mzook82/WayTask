// Copy the settings you need into the ignored Secrets.xcconfig file.
// Keep this template free of real credentials.

// xcconfig treats // as a comment, so preserve the DSN's two slashes with /$()/.
// Example shape only; replace every placeholder locally:
// SENTRY_DSN = https:/$()/PUBLIC_KEY@ORGANIZATION_INGEST_HOST/PROJECT_ID
SENTRY_DSN =

// Existing local integration settings may also live here.
GEMINI_API_KEY =

// Client-safe values only. Use local/development/staging/production explicitly.
// Never put privileged server, database, Apple, SMTP, or monitoring secrets here.
WAYTASK_SUPABASE_ENVIRONMENT =
WAYTASK_SUPABASE_URL =
WAYTASK_SUPABASE_PUBLISHABLE_KEY =

// These remain OFF for WT-032A and require an explicit later release decision.
WAYTASK_CLOUD_ACCOUNTS_ENABLED = NO
WAYTASK_CLOUD_SYNC_ENABLED = NO
WAYTASK_CLOUD_MIGRATION_ENABLED = NO
