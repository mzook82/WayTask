// Copy to the ignored Secrets-Staging.xcconfig for internal staging builds.
// Only the dedicated non-Production project URL and client publishable key are
// permitted. Never put tokens, service-role keys, Apple private keys, database
// passwords, Gemini keys, or other privileged credentials here.
WAYTASK_SUPABASE_URL = https:/$()/STAGING_PROJECT_REF.supabase.co
WAYTASK_SUPABASE_PUBLISHABLE_KEY = REPLACE_WITH_CLIENT_PUBLISHABLE_KEY

// Authentication is the only enabled cloud slice. These stay independently
// disabled until later, separately approved work.
WAYTASK_CLOUD_ACCOUNTS_ENABLED = YES
WAYTASK_CLOUD_SYNC_ENABLED = NO
WAYTASK_CLOUD_MIGRATION_ENABLED = NO
WAYTASK_SECURE_AI_ENABLED = NO
