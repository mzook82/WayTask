// Internal staging only. This configuration never falls back to Production.
// Its separate App ID isolates Apple authorization from the Production bundle.
PRODUCT_BUNDLE_IDENTIFIER = h.WayTask.staging
SENTRY_DSN =
WAYTASK_SUPABASE_ENVIRONMENT = staging
WAYTASK_SUPABASE_URL =
WAYTASK_SUPABASE_PUBLISHABLE_KEY =
WAYTASK_CLOUD_ACCOUNTS_ENABLED = NO
WAYTASK_CLOUD_SYNC_ENABLED = NO
WAYTASK_CLOUD_MIGRATION_ENABLED = NO
WAYTASK_SECURE_AI_ENABLED = NO
// WT-032C activation has independent, machine-checkable security denies.
WAYTASK_MIGRATION_SCHEMA_VERSION = 0
WAYTASK_MIGRATION_ENDPOINT_ENABLED = NO
WAYTASK_SIGNED_SESSION_AB_GATE_PASSED = NO
WAYTASK_SESSION_RECOVERY_GATE_PASSED = NO
WAYTASK_MIGRATION_SECURITY_BLOCKERS_CLEAR = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGING
#include? "Secrets-Staging.xcconfig"
