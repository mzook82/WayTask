{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waytask.app/schemas/product-editorial-release.schema.json",
  "title": "WayTask Product Editorial Release",
  "description": "Editor-owned, locale-aware product changes accepted atomically by the production catalog importer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "taxonomyVersion",
    "generationDate",
    "productCount",
    "releaseId",
    "supportedLocales",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "taxonomyVersion": { "type": "integer", "minimum": 1 },
    "generationDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "productCount": { "type": "integer", "minimum": 0 },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "localizedTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "value"],
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "value": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "localizedTerms": {
      "type": "array",
      "items": { "$ref": "#/$defs/localizedTerm" }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["active", "inactive"] },
        "replacementProductId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/stableId" }
          ]
        },
        "deprecatedSinceCatalogVersion": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonicalNames",
        "localizedDisplayNames",
        "aliases",
        "keywords",
        "brandTerms",
        "categoryId",
        "subcategoryId",
        "barcodes",
        "variantDescriptors",
        "popularityScore",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "canonicalNames": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/nonEmptyText" }
        },
        "localizedDisplayNames": { "$ref": "#/$defs/localizedTerms" },
        "aliases": { "$ref": "#/$defs/localizedTerms" },
        "keywords": { "$ref": "#/$defs/localizedTerms" },
        "brandTerms": { "$ref": "#/$defs/localizedTerms" },
        "legacyNames": { "$ref": "#/$defs/localizedTerms" },
        "brand": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyText" }
          ]
        },
        "categoryId": { "$ref": "#/$defs/stableId" },
        "subcategoryId": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          ]
        },
        "barcodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "semanticKey": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyText" }
          ]
        },
        "variantDescriptors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyText" }
        },
        "packageDescriptor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyText" }
          ]
        },
        "unit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyText" }
          ]
        },
        "provenance": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyText" }
          ]
        },
        "popularityScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "product"],
      "properties": {
        "operation": { "enum": ["add", "replace"] },
        "product": { "$ref": "#/$defs/product" }
      }
    }
  }
}
