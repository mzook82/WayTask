{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waytask.app/schemas/product-catalog.schema.json",
  "title": "WayTask Canonical Product Catalog",
  "description": "Platform-neutral canonical product catalog contract shared by iOS and Android.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "taxonomyVersion",
    "locale",
    "products"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 1
    },
    "taxonomyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "textArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      },
      "uniqueItems": true
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonicalName",
        "categoryId",
        "subcategoryId",
        "aliases",
        "keywords",
        "brandTerms",
        "popularityScore",
        "isActive"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "canonicalName": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "categoryId": {
          "$ref": "#/$defs/stableId"
        },
        "subcategoryId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          ]
        },
        "aliases": {
          "$ref": "#/$defs/textArray"
        },
        "keywords": {
          "$ref": "#/$defs/textArray"
        },
        "brandTerms": {
          "$ref": "#/$defs/textArray"
        },
        "popularityScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "isActive": {
          "type": "boolean"
        },
        "replacementProductId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stableId"
            }
          ]
        },
        "deprecatedSinceCatalogVersion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "legacyNames": {
          "$ref": "#/$defs/textArray"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
