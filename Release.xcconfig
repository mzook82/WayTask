// Release build settings for WayTask.
// Production cannot inherit any developer or staging credential override.
SENTRY_DSN =
WAYTASK_SUPABASE_ENVIRONMENT =
WAYTASK_SUPABASE_URL =
WAYTASK_SUPABASE_PUBLISHABLE_KEY =
WAYTASK_CLOUD_ACCOUNTS_ENABLED = NO
WAYTASK_CLOUD_SYNC_ENABLED = NO
WAYTASK_CLOUD_MIGRATION_ENABLED = NO
WAYTASK_SECURE_AI_ENABLED = NO
// Production carries a second deny path independent of the feature flag.
WAYTASK_MIGRATION_SCHEMA_VERSION = 0
WAYTASK_MIGRATION_ENDPOINT_ENABLED = NO
WAYTASK_SIGNED_SESSION_AB_GATE_PASSED = NO
WAYTASK_SESSION_RECOVERY_GATE_PASSED = NO
WAYTASK_MIGRATION_SECURITY_BLOCKERS_CLEAR = NO
